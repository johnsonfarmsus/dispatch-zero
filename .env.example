# =============================================================================
# Dispatch Zero — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in values appropriate to your environment.
# `.env` is gitignored.
#
# Only DATABASE_URL, REDIS_URL, and SESSION_SECRET are strictly required.
# Everything else has a sensible default in src/dispatchzero/config.py.

# --- Database ---------------------------------------------------------------
# Used both by the app's asyncpg driver and by the postgres container init.
POSTGRES_USER=dispatchzero
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=dispatchzero
DATABASE_URL=postgresql+asyncpg://dispatchzero:change-me-locally@db:5432/dispatchzero

# --- Cache / rate limiting --------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- App core ---------------------------------------------------------------
APP_ENV=development                              # development | production
LOG_LEVEL=INFO
# Cookie signing key. MUST be at least 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-32-bytes-of-randomness

# --- Briefing AI (Ollama Cloud or any OpenAI-compatible endpoint) -----------
# Leaving OLLAMA_API_KEY blank disables AI generation; missions will fall
# back to deterministic placeholder text. Suitable for local dev without
# spending tokens.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT_SECONDS=60

# --- Photo capture / GPS verification ---------------------------------------
# PHOTO_UPLOAD_DIR is where captured photos and composed mission cards live.
# In docker it's a mounted volume; locally any writable directory works.
PHOTO_UPLOAD_DIR=/uploads
PHOTO_MAX_DIMENSION=600                          # resize longest edge to this
PHOTO_JPEG_QUALITY=70
EXIF_FRESHNESS_WINDOW_SECONDS=600                # 10 min between capture & upload
GPS_VERIFICATION_RADIUS_M=80                     # how close you must be to target

# --- Rate limits ------------------------------------------------------------
RATE_LIMIT_MISSION_REQUEST_PER_DAY=50
RATE_LIMIT_MISSION_GENERATE_PER_DAY=50
RATE_LIMIT_SIGNUP_PER_IP_PER_HOUR=10
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900              # 15 min

# --- Session cookie ---------------------------------------------------------
SESSION_COOKIE_NAME=dz_session
SESSION_COOKIE_MAX_AGE_SECONDS=2592000           # 30 days

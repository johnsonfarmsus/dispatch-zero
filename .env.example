# Postgres
POSTGRES_USER=dispatchzero
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=dispatchzero
DATABASE_URL=postgresql+asyncpg://dispatchzero:change-me-locally@db:5432/dispatchzero

# Redis
REDIS_URL=redis://redis:6379/0

# App
APP_ENV=development
SESSION_SECRET=change-me-32-bytes-of-randomness
LOG_LEVEL=INFO

# Rate limits (override only if defaults need tuning)
RATE_LIMIT_MISSION_REQUEST_PER_DAY=50
RATE_LIMIT_MISSION_GENERATE_PER_DAY=50
RATE_LIMIT_SIGNUP_PER_IP_PER_HOUR=10

# Error/disk push alerts (ntfy.sh) — pick an unguessable topic and subscribe on phone via the ntfy app
# Generate one with: python -c "import secrets; print(f'dz-alerts-{secrets.token_urlsafe(8).lower()}')"
NTFY_TOPIC=

# Disk-fill alert (uses NTFY_TOPIC above)
# Force a test alert without filling disk:
#   docker compose exec disk-alert env DISK_ALERT_THRESHOLD=1 /usr/local/bin/check-disk.sh
DISK_ALERT_THRESHOLD=85

# Show the BETA banner on Splash + Home (flip to false for public launch)
SHOW_BETA_BANNER=true

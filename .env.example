# =============================================================================
# Dispatch Zero — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in values appropriate to your environment.
# `.env` is gitignored.
#
# Only DATABASE_URL, REDIS_URL, and SESSION_SECRET are strictly required.
# Everything else has a sensible default in src/dispatchzero/config.py.

# --- Database ---------------------------------------------------------------
# Used both by the app's asyncpg driver and by the postgres container init.
POSTGRES_USER=dispatchzero
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=dispatchzero
DATABASE_URL=postgresql+asyncpg://dispatchzero:change-me-locally@db:5432/dispatchzero

# --- Cache / rate limiting --------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- App core ---------------------------------------------------------------
APP_ENV=development                              # development | production
LOG_LEVEL=INFO
# Cookie signing key. MUST be at least 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-32-bytes-of-randomness

# --- Briefing AI ------------------------------------------------------------
# Default: a local Ollama instance running olmo2:13b on your host machine.
# This matches the canonical production setup and aligns with the project's
# open-source stance (OLMo 2 is Apache-2.0 with open training data + code).
#
# Setup (one-time, ~15 min):
#   1. Install Ollama: https://ollama.com/download
#   2. Pull the model: ollama pull olmo2:13b  (~8 GB download)
#   3. Ollama auto-starts as a service after install (verify: `ollama list`)
#
# Ollama ignores the API key but the OpenAI-compatible client refuses to
# call with an empty key, so set any non-empty string.
#
# host.docker.internal is how the app container reaches the host's Ollama.
# Resolved automatically on Docker Desktop (Mac/Windows). docker-compose.yml
# adds an `extra_hosts` line so it works on Linux Docker too.
OLLAMA_API_KEY=local-noauth
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=olmo2:13b
OLLAMA_TIMEOUT_SECONDS=60

# Alternative: Ollama Cloud (paid, no local setup). Comment the block above
# and uncomment this one. Get an API key at https://ollama.com.
#OLLAMA_API_KEY=<your-ollama-cloud-key>
#OLLAMA_BASE_URL=https://ollama.com/v1
#OLLAMA_MODEL=gemma4:31b-cloud
#OLLAMA_TIMEOUT_SECONDS=60

# --- Photo capture / GPS verification ---------------------------------------
# PHOTO_UPLOAD_DIR is where captured photos and composed mission cards live.
# In docker it's a mounted volume; locally any writable directory works.
PHOTO_UPLOAD_DIR=/uploads
PHOTO_MAX_DIMENSION=600                          # resize longest edge to this
PHOTO_JPEG_QUALITY=70
EXIF_FRESHNESS_WINDOW_SECONDS=600                # 10 min between capture & upload
GPS_VERIFICATION_RADIUS_M=80                     # how close you must be to target

# --- Rate limits ------------------------------------------------------------
RATE_LIMIT_MISSION_REQUEST_PER_DAY=50
RATE_LIMIT_MISSION_GENERATE_PER_DAY=50
RATE_LIMIT_SIGNUP_PER_IP_PER_HOUR=10
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900              # 15 min

# --- Session cookie ---------------------------------------------------------
SESSION_COOKIE_NAME=dz_session
SESSION_COOKIE_MAX_AGE_SECONDS=2592000           # 30 days

# --- Localization / data-source defaults ------------------------------------
# Parameterize US-centric defaults for non-US self-hosters. UI + briefings
# stay English; this controls which slice of the open data is read/written.
WIKIPEDIA_LANGUAGE=en                            # <lang>.wikipedia.org for geosearch + wikipedia= tags
OSM_DEFAULT_RELIGION=christian                   # religion= for published churches; "" to omit

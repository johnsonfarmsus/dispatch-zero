# Copy this file to deploy/.env.local and fill in values for your VPS.
# Both deploy.sh and test.sh source it automatically.
# `.env.local` is gitignored — do not commit your real config.
export DZ_VPS_HOST="root@your-server.example.com"
export DZ_REMOTE_DIR="/opt/dispatchzero"
export DZ_HEALTHCHECK_URL="https://your-instance.example.com/healthz"
